# Mean AI — Environment Variables
# YouTube Data API v3 — App-level shared key (for all users)
# Get a key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your Google Cloud project
# Restrict the key to your domain for security
VITE_SERVER_URL=http://localhost:8000
VITE_YOUTUBE_API_KEY="AIzaSyBeOzHNdbYOkEx_0I3ut_krmeBxNV7A9uQ"

# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible inference
# Get a free nvapi- key at https://build.nvidia.com/models
# Your key is entered in the app (Settings → NVIDIA NIM), NOT here.
# NIM blocks direct browser calls (no CORS headers), so requests go through a
# proxy: /nvidia-api in dev (Vite proxy) and VITE_NVIDIA_PROXY_URL in prod.
# Point this at a relay you control, e.g. https://your-worker.vercel.app/nvidia
# VITE_NVIDIA_PROXY_URL=
